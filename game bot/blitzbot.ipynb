   "source": [
    "import pyautogui as pyg\n",
    "\n",
    "# basex、basey：左上角寶石中心座標；gap：相鄰寶石中心間距\n",
    "for row in range(8):\n",
    "    for col in range(8):\n",
    "        x = basex + col * gap\n",
    "        y = basey + row * gap\n",
    "        color = pyg.pixel(x, y)\n",
    "        print(f\"第 {row + 1} 列、第 {col + 1} 欄 ({x}, {y})：{color}\")"
   ]
  }
